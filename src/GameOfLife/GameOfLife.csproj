<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets this Windows-targeted project compile on Linux/macOS too
         (it still only runs on Windows). Needed for the Ubuntu CI job
         and for compile-checking the UI code without Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>game-of-life</AssemblyName>
    <Description>Conway's Game of Life for Windows: paint cells, run generations, save and open .cells patterns.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameOfLife.Core\GameOfLife.Core.csproj" />
  </ItemGroup>

</Project>
